<script>
(function () {
    'use strict';

    var nav = document.getElementById('siteNav');
    window.addEventListener('scroll', function () {
        if (nav) {
            nav.classList.toggle('scrolled', window.scrollY > 24);
        }
    });

    var reduceMotion = false;
    try {
        reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    } catch (_) {}

    var revealEls = document.querySelectorAll('.site-reveal');
    if (reduceMotion || !('IntersectionObserver' in window)) {
        revealEls.forEach(function (el) { el.classList.add('visible'); });
    } else {
        try {
            var observer = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                        observer.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.12, rootMargin: '0px 0px -48px 0px' });
            revealEls.forEach(function (el) { observer.observe(el); });
        } catch (_) {
            revealEls.forEach(function (el) { el.classList.add('visible'); });
        }
    }

    document.querySelectorAll('.site-preview-card, .site-pillar, .site-feature-row, .site-price-card, .site-cta-card').forEach(function (card) {
        card.addEventListener('mousemove', function (e) {
            var rect = card.getBoundingClientRect();
            card.style.setProperty('--mx', (e.clientX - rect.left) + 'px');
            card.style.setProperty('--my', (e.clientY - rect.top) + 'px');
        });
    });

    var inviteUrl = 'https://discord.com/api/oauth2/authorize?client_id=1439793800309379114&permissions=8&scope=bot%20applications.commands';
    document.querySelectorAll('.js-invite').forEach(function (el) {
        el.addEventListener('click', function (e) {
            e.preventDefault();
            window.open(inviteUrl, '_blank', 'noopener');
        });
    });

    var toggle = document.getElementById('siteNavToggle');
    var links = document.getElementById('siteNavLinks');
    if (toggle && links) {
        toggle.addEventListener('click', function () {
            var isOpen = links.style.display === 'flex';
            toggle.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
            links.style.display = isOpen ? '' : 'flex';
            links.style.flexDirection = isOpen ? '' : 'column';
            links.style.position = isOpen ? '' : 'absolute';
            links.style.top = isOpen ? '' : '100%';
            links.style.left = isOpen ? '' : '0';
            links.style.right = isOpen ? '' : '0';
            links.style.background = isOpen ? '' : 'rgba(5, 7, 12, 0.98)';
            links.style.padding = isOpen ? '' : '1rem 1.25rem';
            links.style.borderBottom = isOpen ? '' : '1px solid rgba(255, 255, 255, 0.08)';
        });
    }
})();
</script>
